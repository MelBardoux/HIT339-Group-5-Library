@model LibrarySystem.ViewModels.ItemTransferCreateViewModel

@{
    ViewData["Title"] = "New Transfer Request";
}

<h1>New Transfer Request</h1>

<div class="row">
    <div class="col-md-6">

        <div class="alert alert-info">
            <strong>Requesting branch:</strong>
            @Model.CurrentBranchName

            <br />

            Select an available item currently held by another branch.
            The item's current branch will be the source of the transfer.
        </div>

        <form asp-controller="ItemTransfers"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="ItemId" class="form-label">
                    Item to Request
                </label>

                <select asp-for="ItemId"
                        asp-items="Model.Items"
                        class="form-select">
                    <option value="">-- Select an item --</option>
                </select>

                <span asp-validation-for="ItemId"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Create Transfer Request
            </button>

            <a asp-controller="ItemTransfers"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}