@model List<LibrarySystem.ViewModels.ItemTransferIndexViewModel>

@{
    ViewData["Title"] = "Item Transfers";
}

<h1>Item Transfers</h1>

<div class="mb-3">
    <a asp-controller="ItemTransfers"
       asp-action="Create"
       class="btn btn-primary">
        New Transfer Request
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        There are currently no item transfers involving your branch.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Library Code</th>
                    <th>Item</th>
                    <th>From Branch</th>
                    <th>To Branch</th>
                    <th>Requested By</th>
                    <th>Status</th>
                    <th>Requested</th>
                    <th>Completed</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var transfer in Model)
                {
                    <tr>
                        <td>@transfer.ItemLibraryCode</td>
                        <td>@transfer.ItemName</td>
                        <td>@transfer.FromBranchName</td>
                        <td>@transfer.ToBranchName</td>
                        <td>@transfer.RequestedByUserEmail</td>
                        <td>@transfer.Status</td>
                        <td>@transfer.RequestedDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @(transfer.CompletedDate.HasValue
                                ? transfer.CompletedDate.Value.ToString("dd/MM/yyyy HH:mm")
                                : "-")
                        </td>

                        <td>
                            @if (transfer.CanApprove)
                            {
                                <form asp-controller="ItemTransfers"
                                      asp-action="Approve"
                                      asp-route-id="@transfer.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-success">
                                        Approve
                                    </button>
                                </form>
                            }

                            @if (transfer.CanReject)
                            {
                                <form asp-controller="ItemTransfers"
                                      asp-action="Reject"
                                      asp-route-id="@transfer.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Reject
                                    </button>
                                </form>
                            }

                            @if (transfer.CanReceive)
                            {
                                <form asp-controller="ItemTransfers"
                                      asp-action="Receive"
                                      asp-route-id="@transfer.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-primary">
                                        Receive
                                    </button>
                                </form>
                            }

                            @if (!transfer.CanApprove &&
                                 !transfer.CanReject &&
                                 !transfer.CanReceive)
                            {
                                <span class="text-muted">No actions</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}