@model LibrarySystem.ViewModels.SearchToyDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<h2>@Model.Name</h2>

<dl class="row">
    <dt class="col-sm-3">Library Code</dt>
    <dd class="col-sm-9">@Model.LibraryCode</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Minimum Age</dt>
    <dd class="col-sm-9">@Model.AgeDisplay</dd>

    <dt class="col-sm-3">Battery Required</dt>
    <dd class="col-sm-9">@(Model.BatteryRequired ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Types</dt>
    <dd class="col-sm-9">
        @if (Model.Types.Any())
        {
            @string.Join(", ", Model.Types)
        }
        else
        {
            <text>None</text>
        }
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.Status == "Available")
        {
            <span class="badge bg-success">@Model.Status</span>
        }
        else
        {
            <span class="badge bg-warning">@Model.Status</span>
        }
    </dd>
</dl>

<a asp-controller="Portal" asp-action="Random" asp-route-type="toy" class="btn btn-primary me-2">Find another toy</a>
<a asp-controller="Portal" asp-action="Index" asp-route-tab="toys" class="btn btn-secondary">Search all toys</a>