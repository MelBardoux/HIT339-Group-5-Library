@model LibrarySystem.ViewModels.SearchMusicDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<h2>@Model.Name</h2>

<dl class="row">
    <dt class="col-sm-3">Library Code</dt>
    <dd class="col-sm-9">@Model.LibraryCode</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Album Title</dt>
    <dd class="col-sm-9">@Model.AlbumTitle</dd>

    <dt class="col-sm-3">Artists</dt>
    <dd class="col-sm-9">
        @if (Model.Artists.Any())
        {
            @string.Join(", ", Model.Artists)
        }
        else
        {
            <text>None</text>
        }
    </dd>

    <dt class="col-sm-3">Release Year</dt>
    <dd class="col-sm-9">@(Model.ReleaseYear ?? "Unknown")</dd>

    <dt class="col-sm-3">Genres</dt>
    <dd class="col-sm-9">
        @if (Model.Genres.Any())
        {
            @string.Join(", ", Model.Genres)
        }
        else
        {
            <text>None</text>
        }
    </dd>

    <dt class="col-sm-3">Formats</dt>
    <dd class="col-sm-9">
        @if (Model.Formats.Any())
        {
            @string.Join(", ", Model.Formats)
        }
        else
        {
            <text>None</text>
        }
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.Status == "Available")
        {
            <span class="badge bg-success">@Model.Status</span>
        }
        else
        {
            <span class="badge bg-warning">@Model.Status</span>
        }
    </dd>
</dl>

<a asp-controller="Portal" asp-action="Random" asp-route-type="music" class="btn btn-primary me-2">Listen to something else</a>
<a asp-controller="Portal" asp-action="Index" asp-route-tab="music" class="btn btn-secondary">Search all music</a>