@model List<LibrarySystem.ViewModels.BorrowerIndexViewModel>

@{
    ViewData["Title"] = "Members";
}

<h2>Members</h2>

<div class="row mb-3">
    <div class="col-md-5">
        <form method="get" asp-action="Index" id="searchForm">
            <div class="input-group">
                <select id="searchSelect" name="searchTerm" class="form-control" style="width: 70%;"></select>
                <input type="hidden" name="status" value="@ViewBag.Status" />
                <button type="submit" class="btn btn-outline-primary">Search</button>
                @if (!string.IsNullOrEmpty((string?)ViewBag.SearchTerm) || !string.IsNullOrEmpty((string?)ViewBag.Status))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
    <div class="col-md-3">
        <form method="get" asp-action="Index">
            <input type="hidden" name="searchTerm" value="@ViewBag.SearchTerm" />
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<LibrarySystem.Models.BorrowerStatus>())
                {
                    <option value="@s" selected="@(ViewBag.Status == s.ToString())">@s</option>
                }
            </select>
        </form>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Member</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Library Card</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var borrower in Model)
        {
            <tr>
                <td>@borrower.LibraryCard</td>
                <td>@borrower.Name</td>
                <td>@borrower.Email</td>
                <td>@borrower.Phone</td>
                <td>@borrower.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@borrower.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@borrower.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@borrower.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <link rel="stylesheet" href="~/lib/select2/select2.min.css" />
    <script src="~/lib/select2/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#searchSelect').select2({
                ajax: {
                    url: '@Url.Action("SearchBorrowers", "Borrowers")',
                    dataType: 'json',
                    delay: 300,
                    data: function(params) {
                        return { term: params.term };
                    },
                    processResults: function(data) {
                        return { results: data };
                    }
                },
                minimumInputLength: 1,
                tags: true,
                placeholder: 'Search by name or library card...',
                allowClear: true,
                createTag: function(params) {
                    var term = $.trim(params.term);
                    if (term === '') return null;
                    return { id: term, text: term };
                }
            });
        });
    </script>
}