@model LibrarySystem.ViewModels.BorrowerDeleteViewModel

@{
    ViewData["Title"] = "Delete Borrower";
}

<h2>Delete Borrower</h2>

<p>Are you sure you want to delete this borrower?</p>

<dl class="row">
    <dt class="col-sm-3">Library Card</dt>
    <dd class="col-sm-9">@Model.LibraryCard</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>