@model LibrarySystem.ViewModels.CsvImportViewModel

@{
    ViewData["Title"] = "CSV Import Preview";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2>CSV Import Preview</h2>
            <p class="text-muted">Review the following items before confirming the import.</p>

            @if (Model.Errors != null && Model.Errors.Any())
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <h4 class="alert-heading">
                        <i class="bi bi-exclamation-triangle"></i> Import Errors
                    </h4>
                    <ul class="mb-0">
                        @foreach (var error in Model.Errors.Take(10))
                        {
                            <li>@error</li>
                        }
                        @if (Model.Errors.Count > 10)
                        {
                            <li><strong>... and @(Model.Errors.Count - 10) more errors</strong></li>
                        }
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Import Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="badge bg-info p-2 w-100 text-center mb-2">
                                <div class="small text-white">Total Rows</div>
                                <div class="fs-5 text-white">@Model.TotalRows</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="badge bg-success p-2 w-100 text-center mb-2">
                                <div class="small text-white">Valid Rows</div>
                                <div class="fs-5 text-white">@Model.ValidRows</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="badge @(Model.Errors.Any() ? "bg-danger" : "bg-success") p-2 w-100 text-center mb-2">
                                <div class="small text-white">Invalid Rows</div>
                                <div class="fs-5 text-white">@(Model.TotalRows - Model.ValidRows)</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="badge bg-primary p-2 w-100 text-center mb-2">
                                <div class="small text-white">Item Type</div>
                                <div class="fs-5 text-white">@Model.ItemType</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.PreviewItems != null && Model.PreviewItems.Any())
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Preview (First 5 items)</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Row #</th>
                                    <th>Item Name</th>
                                    <th>Library Code</th>
                                    <th>@(Model.ItemType == "Book" ? "Author" : "Artist")</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PreviewItems)
                                {
                                    <tr>
                                        <td class="small">@item.RowNumber</td>
                                        <td>@item.ItemName</td>
                                        <td><code>@item.LibraryCode</code></td>
                                        <td>@item.AuthorArtistName</td>
                                        <td>
                                            @if (item.IsValid)
                                            {
                                                <span class="badge bg-success">Valid</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Invalid</span>
                                                @if (item.Errors.Any())
                                                {
                                                    <div class="small mt-1">
                                                        <ul class="mb-0 ps-3">
                                                            @foreach (var error in item.Errors)
                                                            {
                                                                <li>@error</li>
                                                            }
                                                        </ul>
                                                    </div>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (!Model.Errors.Any() && Model.ValidRows > 0)
            {
                <form asp-action="Process" method="post" id="importForm">
                    <input type="hidden" asp-for="CsvContent">
                    <input type="hidden" asp-for="ItemType">
                    <input type="hidden" asp-for="BranchId">

                    <div class="card border-info mb-3">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-check-circle"></i> Ready to Import
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-2">
                                <strong>@Model.ValidRows</strong> item(s) will be imported to <strong>@(Model.Branches?.FirstOrDefault(b => b.Id == Model.BranchId)?.Name ?? "Unknown Branch")</strong>.
                            </p>
                            <p class="text-muted small mb-0">
                                All valid items will be created with status "Available" and added to the selected branch.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a href="@Url.Action("Index", "Import")" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                        <button type="button" class="btn btn-primary" id="confirmImportBtn">
                            <i class="bi bi-check-lg"></i> Confirm Import
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="d-flex gap-2 justify-content-end mt-3">
                    <a href="@Url.Action("Index", "Import")" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Upload
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Import Progress Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h6 class="modal-title" id="importModalLabel">Processing Import</h6>
            </div>
            <div class="modal-body">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p id="progressText">Processing your import... Please wait.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Import Result Modal -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="resultHeader">
                <h6 class="modal-title" id="resultModalLabel">Import Result</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="resultBody">
            </div>
            <div class="modal-footer">
                <a href="@Url.Action("Index", "Import")" class="btn btn-primary">
                    Import Another File
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                    Back to Home
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('confirmImportBtn').addEventListener('click', function () {
            if (confirm('Are you sure you want to import @Model.ValidRows item(s)? This action cannot be undone.')) {
                const importModal = new bootstrap.Modal(document.getElementById('importModal'));
                importModal.show();

                const form = document.getElementById('importForm');
                const formData = new FormData(form);

                fetch('@Url.Action("Process", "Import")', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        importModal.hide();
                        showResult(data);
                    })
                    .catch(error => {
                        importModal.hide();
                        showResult({
                            success: false,
                            message: 'An error occurred: ' + error.message
                        });
                    });
            }
        });

        function showResult(data) {
            const resultModal = new bootstrap.Modal(document.getElementById('resultModal'));
            const header = document.getElementById('resultHeader');
            const body = document.getElementById('resultBody');

            if (data.success) {
                header.className = 'modal-header bg-success text-white';
                body.innerHTML = `
                    <div class="text-center">
                        <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Import Successful</h5>
                        <p class="mb-0">${data.message}</p>
                    </div>
                `;
            } else {
                header.className = 'modal-header bg-danger text-white';
                let errorText = data.message;
                if (data.errors && data.errors.length > 0) {
                    errorText += '<ul class="mt-2 mb-0">';
                    data.errors.slice(0, 5).forEach(e => {
                        errorText += '<li class="small">' + e + '</li>';
                    });
                    if (data.errors.length > 5) {
                        errorText += '<li class="small"><strong>... and ' + (data.errors.length - 5) + ' more</strong></li>';
                    }
                    errorText += '</ul>';
                }
                body.innerHTML = `
                    <div class="text-center">
                        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Import Failed</h5>
                        <p>${errorText}</p>
                    </div>
                `;
            }

            resultModal.show();
        }
    </script>
}
