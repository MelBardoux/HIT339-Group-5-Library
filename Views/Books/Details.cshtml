@model LibrarySystem.ViewModels.BookDetailsViewModel

@{
    ViewData["Title"] = "Book Details";
}

<h2>Book Details</h2>

<dl class="row">
    <dt class="col-sm-3">Library Code</dt>
    <dd class="col-sm-9">@Model.LibraryCode</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Author</dt>
    <dd class="col-sm-9">@Model.AuthorName</dd>

    <dt class="col-sm-3">Publication Year</dt>
    <dd class="col-sm-9">@(Model.PublicationYearUnknown ? "Unknown" : Model.PublicationYear?.ToString())</dd>

    <dt class="col-sm-3">Genres</dt>
    <dd class="col-sm-9">
        @if (Model.Genres.Any())
        {
            @string.Join(", ", Model.Genres)
        }
        @if (Model.OtherGenre && !string.IsNullOrWhiteSpace(Model.OtherGenreText))
        {
            @(Model.Genres.Any() ? ", " : "")
            @Model.OtherGenreText
        }
        @if (!Model.Genres.Any() && !Model.OtherGenre)
        {
            <text>None</text>
        }
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Date Added</dt>
    <dd class="col-sm-9">@Model.DateAdded.ToString("d MMMM yyyy")</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Delete" asp-route-id="@Model.Id">Delete</a> |
    <a asp-action="Index">Back to List</a>
</div>