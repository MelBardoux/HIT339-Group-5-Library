@model LibrarySystem.ViewModels.MusicDetailsViewModel

@{
    ViewData["Title"] = "Music Details";
}

<h2>Music Details</h2>

<dl class="row">
    <dt class="col-sm-3">Library Code</dt>
    <dd class="col-sm-9">@Model.LibraryCode</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Album Title</dt>
    <dd class="col-sm-9">@Model.AlbumTitle</dd>

    <dt class="col-sm-3">Artists</dt>
    <dd class="col-sm-9">
        @if (Model.Artists.Any())
        {
            @string.Join(", ", Model.Artists)
        }
        else
        {
            <text>None</text>
        }
    </dd>

    <dt class="col-sm-3">Release Year</dt>
    <dd class="col-sm-9">@(Model.ReleaseYearUnknown ? "Unknown" : Model.ReleaseYear?.ToString())</dd>

    <dt class="col-sm-3">Genres</dt>
    <dd class="col-sm-9">
        @if (Model.Genres.Any())
        {
            @string.Join(", ", Model.Genres)
        }
        else
        {
            <text>None</text>
        }
    </dd>

    <dt class="col-sm-3">Formats</dt>
    <dd class="col-sm-9">
        @if (Model.Formats.Any())
        {
            @string.Join(", ", Model.Formats)
        }
        else
        {
            <text>None</text>
        }
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Date Added</dt>
    <dd class="col-sm-9">@Model.DateAdded.ToString("d MMMM yyyy")</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Delete" asp-route-id="@Model.Id">Delete</a> |
    <a asp-action="Index">Back to List</a>
</div>