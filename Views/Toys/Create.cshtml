@model LibrarySystem.ViewModels.ToyViewModel

@{
    ViewData["Title"] = "Create Toy";
}

<h2>Create Toy</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MinimumAge" class="form-label">Minimum Age</label>
        <input asp-for="MinimumAge" class="form-control" type="number" min="0" max="18" />
        <span asp-validation-for="MinimumAge" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="BatteryRequired" class="form-check-input" />
        <label asp-for="BatteryRequired" class="form-check-label">Battery Required</label>
    </div>

    <div class="mb-3">
        <label class="form-label">Types</label>
        @for (int i = 0; i < Model.AvailableTypes.Count; i++)
        {
            <div class="form-check">
                <input type="hidden" name="AvailableTypes[@i].Id" value="@Model.AvailableTypes[i].Id" />
                <input type="hidden" name="AvailableTypes[@i].Name" value="@Model.AvailableTypes[i].Name" />
                <input type="checkbox"
                       name="AvailableTypes[@i].IsSelected"
                       value="true"
                       class="form-check-input"
                       id="type_@Model.AvailableTypes[i].Id"
                @(Model.AvailableTypes[i].IsSelected ? "checked" : "") />
                <label class="form-check-label" for="type_@Model.AvailableTypes[i].Id">
                    @Model.AvailableTypes[i].Name
                </label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}