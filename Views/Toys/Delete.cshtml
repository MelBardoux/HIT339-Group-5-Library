@model LibrarySystem.ViewModels.ToyDeleteViewModel

@{
    ViewData["Title"] = "Delete Toy";
}

<h2>Delete Toy</h2>

<p>Are you sure you want to delete this toy?</p>

<dl class="row">
    <dt class="col-sm-3">Library Code</dt>
    <dd class="col-sm-9">@Model.LibraryCode</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Minimum Age</dt>
    <dd class="col-sm-9">@Model.AgeDisplay</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>