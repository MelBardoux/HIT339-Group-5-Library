@using LibrarySystem.Data
@using LibrarySystem.Models
@inject ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Dashboard";
}

@if (User.IsInRole("Admin"))
{
    <div class="section-label mt-2">Administration</div>
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-3">
            <a asp-controller="Import" asp-action="Index" class="dashboard-tile tile-accent-orange">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Bulk Import</div>
                        <p class="tile-desc">Import items via CSV</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Books" asp-action="Index" class="dashboard-tile tile-accent-blue">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Books</div>
                        <p class="tile-desc">Manage book records</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Toys" asp-action="Index" class="dashboard-tile tile-accent-green">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Toys</div>
                        <p class="tile-desc">Manage toy records</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Music" asp-action="Index" class="dashboard-tile tile-accent-purple">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Music</div>
                        <p class="tile-desc">Manage music records</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Notifications" asp-action="Index" class="dashboard-tile tile-accent-orange">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Notifications</div>
                        <p class="tile-desc">View notification log</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
}

@if (User.IsInRole("Reception"))
{
    <div class="section-label mt-2">Reception</div>
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-4">
            <a asp-controller="Import" asp-action="Index" class="dashboard-tile tile-accent-orange">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Bulk Import</div>
                        <p class="tile-desc">Import items via CSV</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a asp-controller="Borrowers" asp-action="Index" class="dashboard-tile tile-accent-blue">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Members</div>
                        <p class="tile-desc">Manage borrower accounts</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a asp-controller="Loans" asp-action="Borrow" class="dashboard-tile tile-accent-green">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">New Loan</div>
                        <p class="tile-desc">Process a new borrowing</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a asp-controller="Loans" asp-action="Index" class="dashboard-tile tile-accent-teal">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Loan Records</div>
                        <p class="tile-desc">Returns, fines and loan history</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a asp-controller="Branches" asp-action="Inventory" class="dashboard-tile tile-accent-purple">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Branch Inventory</div>
                        <p class="tile-desc">View items by branch</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            @{
                var transferStyle = ViewBag.HasPendingTransfers == true ? "background-color: #fff0f0;" : "";
            }
            <a asp-controller="ItemTransfers" asp-action="Index" class="dashboard-tile tile-accent-red">
                <div class="card" style="@transferStyle">
                    <div class="card-body">
                        <div class="tile-title">Item Transfers</div>
                        <p class="tile-desc">Request and manage transfers</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a asp-controller="Notifications" asp-action="Index" class="dashboard-tile tile-accent-orange">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Notifications</div>
                        <p class="tile-desc">View notification log</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a asp-controller="Reservations" asp-action="History" class="dashboard-tile tile-accent-teal">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Reservations</div>
                        <p class="tile-desc">View and manage reservations</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
}

@if (User.IsInRole("Manager"))
{
    <div class="section-label mt-2">Management</div>
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-3">
            <a asp-controller="Import" asp-action="Index" class="dashboard-tile tile-accent-orange">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Bulk Import</div>
                        <p class="tile-desc">Import items via CSV</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Manager" asp-action="Index" class="dashboard-tile tile-accent-blue">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Dashboard</div>
                        <p class="tile-desc">Statistics and reports</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Branches" asp-action="Inventory" class="dashboard-tile tile-accent-green">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Branch Inventory</div>
                        <p class="tile-desc">View items by branch</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="ItemTransfers" asp-action="Index" class="dashboard-tile tile-accent-purple">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Item Transfers</div>
                        <p class="tile-desc">Oversee branch transfers</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Notifications" asp-action="Index" class="dashboard-tile tile-accent-orange">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Notifications</div>
                        <p class="tile-desc">View notification log</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Reservations" asp-action="History" class="dashboard-tile tile-accent-teal">
                <div class="card">
                    <div class="card-body">
                        <div class="tile-title">Reservations</div>
                        <p class="tile-desc">View reservation records</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
}