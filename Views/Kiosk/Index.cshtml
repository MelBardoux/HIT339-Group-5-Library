@{
    ViewData["Title"] = "Welcome";
}
<div class="text-center mb-5">
    <h1 class="display-4" style="font-weight: 500;">Welcome</h1>
    <p class="lead text-muted">Scan your library card to begin, or type the number below.</p>
</div>

@if (TempData["KioskError"] != null)
{
    <div class="alert alert-danger text-center">@TempData["KioskError"]</div>
}

<div class="card border-primary home-card mx-auto" style="max-width: 560px;">
    <div class="card-body p-4 text-center">
        <h5 class="card-title text-primary mb-3" style="font-weight: 600;">Library card</h5>
        <form asp-action="Index" method="post">
            <input id="libraryCard" name="libraryCard" class="form-control kiosk-input mb-3"
                   placeholder="e.g. BRW-0001" autocomplete="off" autofocus required />
            <button type="submit" class="btn btn-primary btn-touch w-100">Continue</button>
        </form>
    </div>
</div>
