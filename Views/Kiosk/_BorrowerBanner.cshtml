@model LibrarySystem.ViewModels.KioskBorrowerViewModel
<div class="card border-primary mb-4">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h4 class="text-primary mb-1" style="font-weight: 600;">Hi, @Model.Name</h4>
            <div class="text-muted">Card @Model.LibraryCard · @Model.ActiveLoanCount item(s) on loan</div>
        </div>
    </div>
</div>
@if (!Model.CanBorrow)
{
    <div class="alert alert-warning">
        @if (Model.IsSuspended) { <span>Your account is suspended. </span> }
        @if (Model.OutstandingFines > 0) { <span>You have @Model.OutstandingFines.ToString("C") in unpaid fines. </span> }
        Please see the front desk before borrowing.
    </div>
}
