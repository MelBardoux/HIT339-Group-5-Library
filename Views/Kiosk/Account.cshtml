@model LibrarySystem.ViewModels.KioskAccountViewModel
@{
    ViewData["Title"] = "My Account";
}
<partial name="_BorrowerBanner" model="Model.Borrower" />

<div class="row g-3 mb-2">
    <div class="col-4"><div class="kiosk-card text-center">
        <div class="display-6 fw-bold">@Model.CurrentLoans.Count</div><div class="text-muted">On loan</div></div></div>
    <div class="col-4"><div class="kiosk-card text-center">
        <div class="display-6 fw-bold text-danger">@Model.CurrentLoans.Count(l => l.IsOverdue)</div><div class="text-muted">Overdue</div></div></div>
    <div class="col-4"><div class="kiosk-card text-center">
        <div class="display-6 fw-bold">@Model.Borrower.OutstandingFines.ToString("C")</div><div class="text-muted">Fines owing</div></div></div>
</div>

<div class="kiosk-card">
    <h2 class="fs-3 mb-3">Items on loan</h2>
    @if (!Model.CurrentLoans.Any())
    {
        <p class="text-muted mb-0">You have no items on loan.</p>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var loan in Model.CurrentLoans)
            {
                <li class="list-group-item d-flex justify-content-between flex-wrap @(loan.IsOverdue ? "list-group-item-danger" : loan.DaysLeft <= 2 ? "list-group-item-warning" : "")">
                    <span><strong>@loan.ItemName</strong> <small class="text-muted">@loan.LibraryCode</small></span>
                    <span>
                        @if (loan.IsOverdue) { <text>Overdue by @(-loan.DaysLeft) day(s)</text> }
                        else if (loan.DaysLeft == 0) { <text>Due today</text> }
                        else { <text>Due @loan.DueDate.ToString("dd/MM/yyyy") (@loan.DaysLeft days)</text> }
                    </span>
                </li>
            }
        </ul>
    }
</div>

@if (Model.UnpaidFines.Any())
{
    <div class="kiosk-card">
        <h2 class="fs-3 mb-3">Unpaid fines</h2>
        <ul class="list-group list-group-flush">
            @foreach (var f in Model.UnpaidFines)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@f.ItemName <small class="text-muted">@f.LibraryCode</small></span>
                    <strong>@(f.Fine?.ToString("C"))</strong>
                </li>
            }
        </ul>
        <p class="mt-3 mb-0 text-muted">Fines can be paid at the front desk.</p>
    </div>
}

@if (Model.ReservedItems.Any())
{
    <div class="kiosk-card">
        <h2 class="fs-3 mb-3">Reservations</h2>
        <ul class="list-group list-group-flush">
            @foreach (var r in Model.ReservedItems) { <li class="list-group-item">@r</li> }
        </ul>
    </div>
}

<a asp-action="Menu" asp-route-card="@Model.Borrower.LibraryCard" class="btn btn-outline-primary btn-lg-touch w-100">Back</a>
