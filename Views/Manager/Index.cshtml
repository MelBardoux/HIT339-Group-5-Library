@model LibrarySystem.ViewModels.ManagerViewModel

@{
    ViewData["Title"] = "Manager Dashboard";
}

<h2>Manager Dashboard</h2>

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-md-3">
        <label class="form-label">Branch</label>
        <select name="branchId" class="form-select">
            <option value="">All Branches</option>
            @foreach (var branch in Model.Branches)
            {
                <option value="@branch.Id" selected="@(Model.BranchId == branch.Id)">@branch.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Start Date</label>
        <input type="date" name="startDate" class="form-control"
               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-3">
        <label class="form-label">End Date</label>
        <input type="date" name="endDate" class="form-control"
               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary me-2">Filter</button>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.BranchName != null)
{
    <div class="alert alert-info py-2">
        Showing data for <strong>@Model.BranchName</strong>
    </div>
}

<ul class="nav nav-tabs mb-4" id="statsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="borrowing-tab" data-bs-toggle="tab" data-bs-target="#borrowing" type="button" role="tab">Borrowing</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="items-tab" data-bs-toggle="tab" data-bs-target="#items" type="button" role="tab">Items</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="fines-tab" data-bs-toggle="tab" data-bs-target="#fines" type="button" role="tab">Fines</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="reservations-tab" data-bs-toggle="tab" data-bs-target="#reservations" type="button" role="tab">Reservations</button>
    </li>
</ul>

<div class="tab-content" id="statsTabContent">

    <!-- Borrowing Tab -->
    <div class="tab-pane fade show active" id="borrowing" role="tabpanel">
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-2">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Total Loans</div>
                        <div class="fw-bold fs-4">@Model.BorrowingStats.TotalLoans</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Active</div>
                        <div class="fw-bold fs-4">@Model.BorrowingStats.ActiveLoans</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2 border-danger">
                    <div class="card-body p-2">
                        <div class="text-danger" style="font-size: 0.8rem;">Overdue</div>
                        <div class="fw-bold fs-4 text-danger">@Model.BorrowingStats.OverdueLoans</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Avg Duration</div>
                        <div class="fw-bold fs-4">@Model.BorrowingStats.AverageLoanDurationDays<small class="text-muted fs-6">d</small></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">On-Time Return</div>
                        <div class="fw-bold fs-4">@Model.BorrowingStats.ReturnRate<small class="text-muted fs-6">%</small></div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.BorrowingStats.MostBorrowedItems.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Most Borrowed Items</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Library Code</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Borrows</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.BorrowingStats.MostBorrowedItems)
                    {
                        <tr>
                            <td>@item.LibraryCode</td>
                            <td>@item.Name</td>
                            <td>@item.Type</td>
                            <td>@item.BorrowCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.BorrowingStats.BusiestBorrowers.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Busiest Borrowers</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Library Card</th>
                        <th>Name</th>
                        <th>Loans</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.BorrowingStats.BusiestBorrowers)
                    {
                        <tr>
                            <td>@b.LibraryCard</td>
                            <td>@b.Name</td>
                            <td>@b.LoanCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.BorrowingStats.LoansPerMonth.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Loans Per Month</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Month</th>
                        <th>Loans</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.BorrowingStats.LoansPerMonth)
                    {
                        <tr>
                            <td>@m.Month</td>
                            <td>@m.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="mt-3">
            <a href="@Url.Action("ExportBorrowingCsv", new { branchId = Model.BranchId, startDate = Model.StartDate, endDate = Model.EndDate })" class="btn btn-outline-success btn-sm">Export CSV</a>
            <a href="@Url.Action("ExportBorrowingPdf", new { branchId = Model.BranchId, startDate = Model.StartDate, endDate = Model.EndDate })" class="btn btn-outline-danger btn-sm">Export PDF</a>
        </div>
    </div>

    <!-- Items Tab -->
    <div class="tab-pane fade" id="items" role="tabpanel">
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-2">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Total Items</div>
                        <div class="fw-bold fs-4">@Model.ItemStats.TotalItems</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Books</div>
                        <div class="fw-bold fs-4">@Model.ItemStats.BookCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Toys</div>
                        <div class="fw-bold fs-4">@Model.ItemStats.ToyCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Music</div>
                        <div class="fw-bold fs-4">@Model.ItemStats.MusicCount</div>
                    </div>
                </div>
            </div>
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card text-center py-2 border-success">
                    <div class="card-body p-2">
                        <div class="text-success" style="font-size: 0.8rem;">On Order</div>
                        <div class="fw-bold fs-4 text-success">@Model.ItemStats.OnOrderCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center py-2 border-info">
                    <div class="card-body p-2">
                        <div class="text-info" style="font-size: 0.8rem;">Reserved</div>
                        <div class="fw-bold fs-4 text-info">@Model.ItemStats.ReservedCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center py-2 border-warning">
                    <div class="card-body p-2">
                        <div class="text-warning" style="font-size: 0.8rem;">Damaged</div>
                        <div class="fw-bold fs-4 text-warning">@Model.ItemStats.DamagedCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center py-2 border-danger">
                    <div class="card-body p-2">
                        <div class="text-danger" style="font-size: 0.8rem;">Lost / Destroyed</div>
                        <div class="fw-bold fs-4 text-danger">@(Model.ItemStats.LostCount + Model.ItemStats.DestroyedCount)</div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.ItemStats.StatusCounts.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Items by Status</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Status</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.ItemStats.StatusCounts)
                    {
                        <tr>
                            <td>@s.Status</td>
                            <td>@s.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.ItemStats.PopularGenres.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Popular Book Genres</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Genre</th>
                        <th>Books</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model.ItemStats.PopularGenres)
                    {
                        <tr>
                            <td>@g.Genre</td>
                            <td>@g.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.ItemStats.ItemsAddedPerMonth.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Items Added Per Month</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Month</th>
                        <th>Items</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.ItemStats.ItemsAddedPerMonth)
                    {
                        <tr>
                            <td>@m.Month</td>
                            <td>@m.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="mt-3">
            <a href="@Url.Action("ExportItemsCsv", new { branchId = Model.BranchId })" class="btn btn-outline-success btn-sm">Export CSV</a>
            <a href="@Url.Action("ExportItemsPdf", new { branchId = Model.BranchId })" class="btn btn-outline-danger btn-sm">Export PDF</a>
        </div>
    </div>

    <!-- Fines Tab -->
    <div class="tab-pane fade" id="fines" role="tabpanel">
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Outstanding</div>
                        <div class="fw-bold fs-4 text-danger">@Model.FineStats.OutstandingFines.ToString("C")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Collected</div>
                        <div class="fw-bold fs-4">@Model.FineStats.TotalFinesCollected.ToString("C")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Avg Fine</div>
                        <div class="fw-bold fs-4">@Model.FineStats.AverageFineAmount.ToString("C")</div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.FineStats.FinesPerBranch.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Fines by Branch</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Branch</th>
                        <th>Count</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.FineStats.FinesPerBranch)
                    {
                        <tr>
                            <td>@b.BranchName</td>
                            <td>@b.FineCount</td>
                            <td class="text-danger">@b.TotalFines.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.FineStats.FinesPerMonth.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Fines by Month</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Month</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.FineStats.FinesPerMonth)
                    {
                        <tr>
                            <td>@m.Month</td>
                            <td class="text-danger">@m.Amount.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.FineStats.BorrowersWithOutstandingFines.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Borrowers with Outstanding Fines</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Library Card</th>
                        <th>Name</th>
                        <th>Total Fines</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.FineStats.BorrowersWithOutstandingFines)
                    {
                        <tr>
                            <td>@b.LibraryCard</td>
                            <td>@b.Name</td>
                            <td class="text-danger">@b.TotalFines.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="mt-3">
            <a href="@Url.Action("ExportFinesCsv", new { branchId = Model.BranchId, startDate = Model.StartDate, endDate = Model.EndDate })" class="btn btn-outline-success btn-sm">Export CSV</a>
            <a href="@Url.Action("ExportFinesPdf", new { branchId = Model.BranchId, startDate = Model.StartDate, endDate = Model.EndDate })" class="btn btn-outline-danger btn-sm">Export PDF</a>
        </div>
    </div>

    <!-- Reservations Tab -->
    <div class="tab-pane fade" id="reservations" role="tabpanel">
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-2">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Total</div>
                        <div class="fw-bold fs-4">@Model.ReservationStats.TotalReservations</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2 border-info">
                    <div class="card-body p-2">
                        <div class="text-info" style="font-size: 0.8rem;">Waiting</div>
                        <div class="fw-bold fs-4 text-info">@Model.ReservationStats.WaitingCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2 border-warning">
                    <div class="card-body p-2">
                        <div class="text-warning" style="font-size: 0.8rem;">Ready</div>
                        <div class="fw-bold fs-4 text-warning">@Model.ReservationStats.ReadyCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2 border-success">
                    <div class="card-body p-2">
                        <div class="text-success" style="font-size: 0.8rem;">Collected</div>
                        <div class="fw-bold fs-4 text-success">@Model.ReservationStats.CollectedCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center py-2">
                    <div class="card-body p-2">
                        <div class="text-muted" style="font-size: 0.8rem;">Avg Wait</div>
                        <div class="fw-bold fs-4">@Model.ReservationStats.AverageWaitDays<small class="text-muted fs-6">d</small></div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.ReservationStats.ReservationsByBranch.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Reservations by Branch</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Branch</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.ReservationStats.ReservationsByBranch)
                    {
                        <tr>
                            <td>@b.BranchName</td>
                            <td>@b.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.ReservationStats.MostReservedItems.Any())
        {
            <h6 class="text-uppercase text-muted mb-2" style="font-size: 0.8rem; letter-spacing: 0.05em;">Most Reserved Items</h6>
            <table class="table table-sm table-bordered table-striped mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Library Code</th>
                        <th>Name</th>
                        <th>Reservations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ReservationStats.MostReservedItems)
                    {
                        <tr>
                            <td>@item.LibraryCode</td>
                            <td>@item.Name</td>
                            <td>@item.ReservationCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="mt-3">
            <a href="@Url.Action("ExportReservationsCsv", new { branchId = Model.BranchId })" class="btn btn-outline-success btn-sm">Export CSV</a>
            <a href="@Url.Action("ExportReservationsPdf", new { branchId = Model.BranchId })" class="btn btn-outline-danger btn-sm">Export PDF</a>
        </div>
    </div>
</div>