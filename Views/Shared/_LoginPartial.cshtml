@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var email = User.Identity?.Name ?? "";
        var localPart = email.Split('@')[0];
        string greeting;

        if (localPart.Contains('.'))
        {
            var parts = localPart.Split('.');
            var branch = char.ToUpper(parts[0][0]) + parts[0].Substring(1);
            var role = parts[1].ToLower() switch
            {
                "receptionists" => "Reception",
                "manager" => "Manager",
                _ => char.ToUpper(parts[1][0]) + parts[1].Substring(1)
            };
            greeting = $"Hello {role}! ({branch})";
        }
        else
        {
            greeting = $"Hello {char.ToUpper(localPart[0]) + localPart.Substring(1)}!";
        }

        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">@greeting</a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>